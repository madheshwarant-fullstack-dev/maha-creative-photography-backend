# Server Port (Render will provide this automatically via process.env.PORT)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/<database-name>?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
# Use a strong, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Production URL (for CORS allowance and email links)
# Example: https://maha-creative-photography-website.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ================= CLOUDINARY CONFIGURATION =================
# Required for permanent cloud image storage for Gallery and Packages
# Sign up at https://cloudinary.com/ and retrieve credentials from the dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================= EMAIL / SMTP CONFIGURATION =================
# For transactional emails (Password Reset, Booking Confirmation, Admin Alerts, Contact Notifications)
# If using Gmail:
# 1. Enable 2-Step Verification in Google Account Settings.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in EMAIL_USER and 16-character password in EMAIL_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM="Maha Creative Photography" <your_email@gmail.com>
ADMIN_EMAIL=admin@mahacreative.com
EMAIL_LOGO_URL=
