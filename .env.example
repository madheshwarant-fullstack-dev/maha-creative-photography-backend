# Server Port (Render will provide this automatically via process.env.PORT)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/<database-name>?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
# Use a strong, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Production URL (for CORS allowance)
# Example: https://maha-creative-photography-website.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service Configuration for Password Recovery
# Set EMAIL_USER and EMAIL_PASSWORD with your SMTP provider (e.g. Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
# Optional custom SMTP configuration:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_FROM="Maha Creative Photography" <your_email@gmail.com>
# EMAIL_LOGO_URL=https://your-domain.com/images/Logo.png
